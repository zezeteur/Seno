# Secrets des Edge Functions (jamais dans l'app Flutter).
# Local :      cp .env.example .env  puis  supabase functions serve --env-file supabase/functions/.env
# Production : supabase secrets set --env-file supabase/functions/.env

# Signature des QR codes
QR_SECRET=

# Jèko — Dashboard Business > Paramètres > API & Webhooks
JEKO_API_URL=https://api.jeko.africa/partner_api
JEKO_API_KEY=
JEKO_API_KEY_ID=
# Secret du webhook (vérification HMAC-SHA256 de l'en-tête Jeko-Signature)
JEKO_WEBHOOK_SECRET=
# Boutique Jèko qui encaisse et reverse
JEKO_STORE_ID=
# Retour après paiement : URL https obligatoires (Jèko refuse seno://…) ; l'app suit le statut elle-même
JEKO_SUCCESS_URL=
JEKO_ERROR_URL=
